# MC03 runtime configuration. Do not put secrets in this file.
MC03_ENVIRONMENT=development
MC03_PUBLIC_LISTENER__HOST=127.0.0.1
MC03_PUBLIC_LISTENER__PORT=8001
MC03_PRIVATE_PORTAL__HOST=127.0.0.1
MC03_PRIVATE_PORTAL__PORT=8000
MC03_RUNNER_ID=local-runner
MC03_STORAGE_ROOT=var/mc03
# Optional path overrides must remain below MC03_STORAGE_ROOT and on the same local volume.
# MC03_DATABASE_PATH=var/mc03/mc03.sqlite3
# MC03_RAW_SOURCE_PATH=var/mc03/raw_sources
# MC03_ARTIFACT_PATH=var/mc03/artifacts
# MC03_TEMPLATE_PATH=var/mc03/templates
# MC03_FIXED_FILE_LOCK_PATH=var/mc03/generation.lock
