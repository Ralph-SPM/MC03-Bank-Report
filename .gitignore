# ==============================================================================
# Scratch, Ad-hoc Scripts & Data Dumps (Contains sensitive bank loan remarks / PII)
# ==============================================================================
scratch/
var/
output/
outputs/
exports/
reports/

# Spreadsheet dumps & raw bank workbooks (prevents accidental commit of PII)
*.xlsx
*.xls
*.xlsm
*.csv
!tests/fixtures/*.xlsx
!tests/fixtures/*.csv

# Database files & SQLite journals
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db3

# Runtime locks (do not ignore uv.lock)
generation.lock
*.lock.file
*.pid

# Generated report archives & exports
*.zip
*.tar
*.tar.gz
*.7z

